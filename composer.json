{
    "name": "systonia/waypoint-i18n",
    "description": "Translations and per-request locale for Waypoint: catalogs, {placeholder} and plural messages, $this->t() in views, translated validation errors.",
    "type": "library",
    "license": ["MIT", "Apache-2.0"],
    "require": {
        "php": ">=8.5",
        "systonia/waypoint": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Waypoint\\I18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waypoint\\I18n\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "stan": "phpstan analyse"
    }
}
